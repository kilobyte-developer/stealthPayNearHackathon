# ---------------------------------------------------------------------------
# StealthPay contracts — Fuji TESTNET only.
#
# Setup:
#   1. Copy this file:  cp .env.example .env   (from inside contracts/)
#   2. Fill in DEPLOYER_PRIVATE_KEY below with a DEDICATED Fuji-only wallet.
#   3. Fund that wallet from the Fuji faucet (link below).
#   4. Leave FUJI_ANNOUNCER_ADDRESS / FUJI_PAYMENT_ROUTER_ADDRESS blank — the
#      deploy scripts fill these in themselves after deploying.
#
# `.env` is gitignored — never commit it, never paste its contents anywhere.
# Never put a mainnet key here. This wallet should hold ONLY worthless
# testnet AVAX and nothing else.
# ---------------------------------------------------------------------------

# Optional. Leave as-is to use the public Avalanche Fuji endpoint. Only
# change this if you have your own RPC endpoint (e.g. from a provider like
# Infura, Alchemy, or Ankr) and want to use that instead.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# REQUIRED. Private key of a dedicated Fuji deployer, 0x-prefixed (66
# characters total, including the 0x). Must be plain hex on a single line —
# not encrypted, not base64, not wrapped across multiple lines.
#
# How to get one:
#   - Create a brand-new account in a wallet you already use (e.g. in
#     MetaMask: Account menu -> Add account -> New account), then export its
#     private key (Account details -> Show private key). Use a NEW account,
#     not one holding any real funds on any network.
#   - Paste that key below. Never share it, screenshot it, or send it to
#     anyone/anything else — including in chat with an AI assistant.
#
# Then fund the SAME account's address (not the key) from the Fuji faucet:
#   https://core.app/tools/testnet-faucet/
DEPLOYER_PRIVATE_KEY=

# Filled in automatically by the deploy scripts (written to
# contracts/deployments/fuji.json). Leave blank. Set manually only to force
# a script to use a specific address instead of what it would deploy/reuse.
FUJI_ANNOUNCER_ADDRESS=
FUJI_PAYMENT_ROUTER_ADDRESS=
